<UserControl x:Class="LidWorkMode.LidWorkModeControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid MaxWidth="820" Margin="0,0,24,36" HorizontalAlignment="Left">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Text="合盖继续运行" FontSize="28" FontWeight="SemiBold" />
          <TextBlock Margin="0,8,0,0" Text="仅在本次工具箱运行期间生效，关闭后自动恢复原设置。" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <ui:Card Grid.Row="1" Margin="0,28,0,0" Padding="22">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="当前电源状态" FontSize="17" FontWeight="SemiBold" />
              <TextBlock x:Name="PowerSummaryText" Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <ui:Badge x:Name="StateBadge" Grid.Column="1" Appearance="Secondary" Content="待命" VerticalAlignment="Top" />
            <Expander Grid.Row="2" Grid.ColumnSpan="2" Margin="0,14,0,0" Header="技术详情">
              <TextBlock x:Name="SchemeText" Margin="0,8,0,4" TextWrapping="Wrap" FontFamily="Consolas" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Expander>
          </Grid>
        </ui:Card>

        <ui:Card Grid.Row="2" Margin="0,18,0,0" Padding="22">
          <StackPanel>
            <TextBlock Text="本次启用范围" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Margin="0,4,0,14" Text="选择要临时修改的供电状态。" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="插电时合盖继续运行" FontWeight="SemiBold"/><TextBlock Margin="0,3,0,0" Text="推荐，适合持续任务和散热" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel><ui:ToggleSwitch x:Name="AcToggle" Grid.Column="1" IsChecked="True" AutomationProperties.Name="插电时合盖继续运行"/></Grid>
            <Separator Margin="0,12" />
            <Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="使用电池时也继续运行" FontWeight="SemiBold"/><TextBlock Margin="0,3,0,0" Text="会增加耗电和合盖积热" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel><ui:ToggleSwitch x:Name="DcToggle" Grid.Column="1" Checked="DcToggle_Checked" AutomationProperties.Name="使用电池时也继续运行"/></Grid>
            <Separator Margin="0,12" />
            <Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="同时禁止空闲睡眠" FontWeight="SemiBold"/><TextBlock Margin="0,3,0,0" Text="仅当任务仍会被空闲睡眠中断时使用" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel><ui:ToggleSwitch x:Name="IdleToggle" Grid.Column="1" AutomationProperties.Name="同时禁止空闲睡眠"/></Grid>
          </StackPanel>
        </ui:Card>

        <ui:InfoBar Grid.Row="3" Margin="0,18,0,0" IsOpen="True" Severity="Warning" Title="注意散热" Message="合盖运行时请放在通风、坚硬的表面；不要放进背包、床铺或被褥。" />

        <StackPanel Grid.Row="4" Margin="0,22,0,0">
          <StackPanel Orientation="Horizontal">
            <ui:Button x:Name="EnableButton" Width="210" Height="46" Appearance="Primary" Content="启用本次合盖运行" FontWeight="SemiBold" Click="Enable_Click" />
            <ui:Button x:Name="RestoreButton" Margin="12,0,0,0" Width="180" Height="46" Content="立即恢复原设置" IsEnabled="False" Click="Restore_Click" />
            <ProgressBar x:Name="BusyProgress" Margin="18,0,0,0" Width="120" IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Center" />
          </StackPanel>
          <ui:InfoBar x:Name="StatusBar" Margin="0,18,0,0" IsOpen="True" Severity="Informational" Title="尚未启用" Message="当前不会修改电源设置。" />
        </StackPanel>
      </Grid>
    </ScrollViewer>
    <ui:ContentDialogHost x:Name="DialogHost" />
  </Grid>
</UserControl>
